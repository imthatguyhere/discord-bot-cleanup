# Your bot token (required). Reset it in the Developer Portal -> your app -> Bot.
DISCORD_TOKEN=your-bot-token-here

# Optional: same as passing --guild <id> (a numeric snowflake).
# When set, only this guild's commands are cleaned; global commands are left alone.
DISCORD_GUILD_ID=

# Optional: also make the bot leave the guild after cleaning it (same as --leave).
# Accepts 1, true, y or yes. Setting true does NOT leave silently — you will
# still be asked to confirm twice at run time. Only --yes skips confirmations.
# Keep it unset/false unless you really mean it.
DISCORD_LEAVE_GUILD=false
